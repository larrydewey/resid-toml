// derive.resid — instances generated by resid-derive, run over TOML. The
// point is not the derive itself (resid-serial tests that) but that the
// generated code needs nothing from a format beyond the protocol, so the
// same instances work here.
//
// A TOML document is a table, so a value that is a bare scalar, a bare
// variant or a bare array has no spelling at the top of a document. The
// wrappers below are hand-written and put those values in a table, which is
// also how they would be written in practice.

import "../src/toml.resid";
import "model_serial.resid";
import "check.resid";

type Box = { Meters m; };

@needs(Encoder(F))
Result(F, SerialError) enc_box(Box v, F s) {
    F s1 = write_struct_begin(s, "Box", 1)?;
    F s2 = write_named(s1, "m", v.m)?;
    return write_struct_end(s2);
}
Encode(Box, F) = enc_box;

type LooseBox = { Loose l; };

@needs(Decoder(F))
Result(Parsed(Box, F), SerialError) dec_box(F s) {
    F s1 = read_struct_begin(s, "Box", ["m"])?;
    return dec_box_fields(s1, None);
}
Decode(Box, F) = dec_box;

@needs(Decoder(F))
Result(Parsed(Box, F), SerialError) dec_box_fields(F s, Option(Meters) m) {
    Parsed(FieldKey, F) k = read_field(s, ["m"])?;
    FieldKey key = k.value;
    return match key {
        KnownField(i) => dec_box_slot(k.rest, i, m),
        UnknownField(name) => dec_box_fields(skip_unknown(k.rest, name, ["m"], false)?, m),
        EndOfFields => parsed(Box {.m = require(m, "m")?}, k.rest)
    };
}

@needs(Decoder(F))
Result(Parsed(Box, F), SerialError) dec_box_slot(F s, Int i, Option(Meters) m) {
    Parsed(Option(Meters), F) v = read_slot(s, m, "m")?;
    return dec_box_fields(v.rest, v.value);
}

@needs(Decoder(F))
Result(Parsed(LooseBox, F), SerialError) dec_loose_box(F s) {
    F s1 = read_struct_begin(s, "LooseBox", ["l"])?;
    return dec_loose_box_fields(s1, None);
}
Decode(LooseBox, F) = dec_loose_box;

@needs(Decoder(F))
Result(Parsed(LooseBox, F), SerialError) dec_loose_box_fields(F s, Option(Loose) l) {
    Parsed(FieldKey, F) k = read_field(s, ["l"])?;
    FieldKey key = k.value;
    return match key {
        KnownField(i) => dec_loose_box_slot(k.rest, i, l),
        UnknownField(name) => dec_loose_box_fields(skip_unknown(k.rest, name, ["l"], false)?, l),
        EndOfFields => parsed(LooseBox {.l = require(l, "l")?}, k.rest)
    };
}

@needs(Decoder(F))
Result(Parsed(LooseBox, F), SerialError) dec_loose_box_slot(F s, Int i, Option(Loose) l) {
    Parsed(Option(Loose), F) v = read_slot(s, l, "l")?;
    return dec_loose_box_fields(v.rest, v.value);
}

@needs(Encoder(F))
Result(F, SerialError) enc_loose_box(LooseBox v, F s) {
    F s1 = write_struct_begin(s, "LooseBox", 1)?;
    F s2 = write_named(s1, "l", v.l)?;
    return write_struct_end(s2);
}
Encode(LooseBox, F) = enc_loose_box;

Str cfg_text(Config c) { return hex_text_of(to_toml(c)); }

Str config_err(Result(Config, SerialError) r) {
    if (Err(e) = r) { return "decode: " + error_text(e); }
    if (Ok(c) = r) { return f"{c.host_name}/{c.login_count}"; }
    return "unreachable";
}

Str config_text(Str text) {
    Result(Config, SerialError) r = from_toml(text);
    return config_err(r);
}

Str event_err(Result(Event, SerialError) r) {
    if (Err(e) = r) { return "decode: " + error_text(e); }
    if (Ok(ev) = r) { return show_event(ev); }
    return "unreachable";
}

Str event_text(Str text) {
    Result(Event, SerialError) r = from_toml(text);
    return event_err(r);
}

Str show_event(Event ev) {
    Event e = ev;
    return match e {
        Started(c) => f"Started({c.host_name})",
        Stopped => "Stopped"
    };
}

Str box_text(Box b) { return hex_text_of(to_toml(b)); }

Str box_back(Str text) {
    Result(Box, SerialError) r = from_toml(text);
    if (Err(e) = r) { return "decode: " + error_text(e); }
    if (Ok(v) = r) { return f"{v.m.value}"; }
    return "unreachable";
}

Str loose_box_text(LooseBox b) { return hex_text_of(to_toml(b)); }

Str loose_box_back(Str text) {
    Result(LooseBox, SerialError) r = from_toml(text);
    if (Err(e) = r) { return "decode: " + error_text(e); }
    if (Ok(v) = r) { return show_loose(v.l); }
    return "unreachable";
}

Str show_loose(Loose l) {
    Loose got = l;
    return match got { Num(n) => f"Num({n})", Word(s) => f"Word({s})", Nothing => "Nothing" };
}

Int main() {
    Option(Str) some_mail = Some("a@b");
    Config c = Config {.host_name = "example.com", .login_count = 3, .email = some_mail, .secret = "hunter2"};

    // rename_all camelCase, rename, skip, and the field order as written:
    // a table whose keys are the fields.
    check_text("config/text", cfg_text(c), "hostname = \"example.com\"\nloginCount = 3\nemail = \"a@b\"\n");

    // Round trip, and the alias on decode.
    check_text("config/back", config_text("hostname = \"example.com\"\nloginCount = 3\nemail = \"a@b\"\n"), "example.com/3");
    check_text("config/alias", config_text("server = \"example.com\"\nloginCount = 3\n"), "example.com/3");

    // An absent Option field decodes as None; a default fills in.
    check_text("config/minimal", config_text("hostname = \"h\"\n"), "h/0");

    // skip_encoding_if drops the field entirely.
    Option(Str) no_mail = None;
    Config bare = Config {.host_name = "h", .login_count = 1, .email = no_mail, .secret = "s"};
    check_text("config/skipped", cfg_text(bare), "hostname = \"h\"\nloginCount = 1\n");

    // deny_unknown_fields.
    Result(Config, SerialError) unknown = from_toml("hostname = \"h\"\nzzz = 1\n");
    check_text("config/deny unknown", config_err(unknown), "decode: unknown field `zzz`, expected `hostname`, `server`, `loginCount` or `email`");

    // An internally tagged enum: a table with the tag key in it, the
    // variant names in snake_case. At the top of a document the tag and the
    // payload's fields are the document's keys.
    check_text("event/started", hex_text_of(to_toml(Started(bare))), "kind = \"started\"\nhostname = \"h\"\nloginCount = 1\n");
    check_text("event/stopped", hex_text_of(to_toml(Stopped)), "kind = \"stopped\"\n");
    check_text("event/back", event_text("kind = \"started\"\nhostname = \"h\"\nloginCount = 1\n"), "Started(h)");
    check_text("event/unit back", event_text("kind = \"stopped\"\n"), "Stopped");
    check_text("event/unknown kind", event_text("kind = \"coop\"\n"), "decode: unknown variant `coop`, expected `started` or `stopped`");

    // A variant that is a field of a table is written as an inline table,
    // since a table is a value there and needs no section of its own.
    // A table written as a value is a section, since a section is how a
    // table reaches a document, and it reads back the same either way.
    check_text("event/nested", hex_text_of(to_toml(Stopped2 {.k = Stopped})), "[k]\nkind = \"stopped\"\n");

    // transparent: the one field, with no wrapper around it.
    check_text("meters", box_text(Box {.m = Meters {.value = 1.5}}), "m = 1.5\n");
    check_text("meters/back", box_back("m = 1.5\n"), "1.5");
    // A transparent value has no spelling at the top of a document.
    check_text("meters/bare", hex_text_of(to_toml(Meters {.value = 1.5})),
        "a TOML document, whose top level is a table is not supported by this format");

    // untagged: the payload alone, tried in order.
    check_text("loose/num", loose_box_text(LooseBox {.l = Num(5)}), "l = 5\n");
    check_text("loose/word", loose_box_text(LooseBox {.l = Word("w")}), "l = \"w\"\n");
    check_text("loose/num back", loose_box_back("l = 5\n"), "Num(5)");
    check_text("loose/word back", loose_box_back("l = \"w\"\n"), "Word(w)");
    // A unit variant of an untagged enum is tried last and has no spelling.
    check_text("loose/nothing", loose_box_text(LooseBox {.l = Nothing}),
        "a unit value, which TOML has no spelling for is not supported by this format at .l");

    return 0;
}

// A variant that is a field, so it is written inside braces.
type Stopped2 = { Event k; };

@needs(Encoder(F))
Result(F, SerialError) enc_stopped2(Stopped2 v, F s) {
    F s1 = write_struct_begin(s, "Stopped2", 1)?;
    F s2 = write_named(s1, "k", v.k)?;
    return write_struct_end(s2);
}
Encode(Stopped2, F) = enc_stopped2;
